{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phoneya2",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phoneya2-core",
      "database_id": "68c3c9fb-27bd-4e31-a7d5-533aab22727b",
      "migrations_dir": "d1/migrations"
    }
  ],
  "pages_build_output_dir": ".",
  "r2_buckets": [
    {
      "binding": "PARTNER_MEDIA",
      "bucket_name": "phoneya2-partner-media"
    }
  ]
}
